# Copy to .env.production and replace every generated value before deployment.
OPEN_NOTEBOOK_IMAGE=ghcr.io/lfnovo/open-notebook:v1-latest
OPEN_NOTEBOOK_PORT=8502
OPEN_NOTEBOOK_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
OPEN_NOTEBOOK_PASSWORD=replace-with-a-strong-login-password
CORS_ORIGINS=https://notebook.example.com
SURREAL_USER=open_notebook_admin
SURREAL_PASSWORD=replace-with-at-least-16-random-characters
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=open_notebook
OPEN_NOTEBOOK_WORKER_MAX_TASKS=5
OPEN_NOTEBOOK_MODEL_ROUTING_POLICY=hybrid
